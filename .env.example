# Copy to .env and adjust. Never commit .env.

# SQLite by default (file in the project root). For PostgreSQL via docker compose:
# DATABASE_URL=postgresql+psycopg://moleculab:moleculab@localhost:5432/moleculab
DATABASE_URL=sqlite:///./moleculab.db

# Polite-use contact for NCBI E-utilities and Crossref (recommended)
CONTACT_EMAIL=
# Optional NCBI key raises the PubMed rate limit from 3 to 10 requests/second
NCBI_API_KEY=

HTTP_TIMEOUT=15
HTTP_MAX_RETRIES=2

# Research assistant. "none" = retrieval-only answers (no generation).
# "anthropic" requires `pip install anthropic`; the key may also come from ANTHROPIC_API_KEY.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5

# Expert review (write access). Empty = review mutations disabled (read-only demo).
# Format: "Reviewer Name=token;Other Reviewer=token2". Tokens need at least 16 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(24))"
REVIEWER_TOKENS=

# Semantic claim verification: "deterministic" (default) or "llm" (adds the configured LLM as a second
# verifier that can only lower verdicts; needs LLM_PROVIDER). Unavailable/malformed LLM output => abstain.
SEMANTIC_VERIFIER=deterministic

# Research workspaces. Empty = local single-user mode (loopback clients only; NOT private).
# Format: "Researcher Name=token;Other=token2" (tokens >= 16 chars) for per-researcher isolation.
RESEARCHER_TOKENS=
